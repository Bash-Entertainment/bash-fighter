{
  "name": "bash-fighter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w @bash-fighter/server && npm run build -w @bash-fighter/app",
    "test": "node scripts/run-tests.mjs packages/*/test/**/*.test.ts scripts/test/*.test.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:server": "node scripts/run-tests.mjs --test-concurrency=1 server/test/*.test.ts",
    "test:all": "npm test && npm run test:server",
    "build:itch": "npm run build:itch -w @bash-fighter/app && node scripts/package-itch-zip.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
